{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Aurix Desktop App - AI Voice Assistant with Deepgram, Groq, and RAG",
  "author": "Aurix Team",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite --mode electron",
    "electron:preview": "tsc -b && vite build && electron .",
    "electron:build": "tsc -b && vite build && electron-builder",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,html}\" \"electron/**/*.{ts,js}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.11.0",
    "@qdrant/js-client-rest": "^1.16.2",
    "bufferutil": "^4.0.9",
    "cohere-ai": "^7.20.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "groq-sdk": "^0.37.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "utf-8-validate": "^6.0.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.12",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
